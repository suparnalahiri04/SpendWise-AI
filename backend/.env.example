# SpendWise AI — Backend Environment Configuration Template
# Copy this file to `backend/.env` and replace placeholders with your actual values.
# NEVER commit the real `backend/.env` file to version control.

# PostgreSQL Database Connection (defaults match app/database.py Settings)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_database_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=spendwise_ai

# Authentication & Security
# IMPORTANT: JWT_SECRET_KEY must contain at least 32 non-whitespace characters.
# Generate a secure key with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=change_this_to_a_secure_random_key_of_at_least_32_characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list of allowed frontend origins loaded through Settings.
# Default local dev origins match http://localhost:5173, http://127.0.0.1:5173, etc.
# In production, set this to your deployed frontend origin(s), e.g.:
#   CORS_ALLOWED_ORIGINS=https://your-app.example.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://[::1]:5173,http://localhost:5174,http://127.0.0.1:5174
